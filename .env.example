# PostHog Configuration
# Get your API key and Project ID from https://app.posthog.com
NEXT_PUBLIC_POSTHOG_API_KEY=phc_your_api_key_here
NEXT_PUBLIC_POSTHOG_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Brevo (Sendinblue) Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=your_email@example.com
CONTACT_TO_EMAIL=your_contact_email@example.com

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
